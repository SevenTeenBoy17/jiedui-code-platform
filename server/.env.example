# 复制为 server/.env 后填入真实值。**.env 不入库**（见根 .gitignore）。
# 源码里没有任何兜底值 —— 兜底值就是密钥泄漏的来源。

# 大模型（Anthropic 兼容接口）
AI_API_KEY=
AI_API_BASE_URL=https://gpt-agent.cc/v1
AI_MODEL=claude-sonnet-4-6
# 生图端点（国内更快，失败自动回落 gpt-agent.cc）
AI_IMG_URL=https://api.llm-token.cn/v1/images/generations

# 研究导出假名盐。**正式采集数据前必须设一个固定值并妥善保管**：
# 不设的话每次重启进程都会换随机盐，分批导出的假名对不上，前后测配不上，数据作废。
JIEDUI_EXPORT_SALT=
