+"""决策1·方案A（guidance-fading）的语义钉死测试。
+
+方案A 的主张只有一句：**渐退撤的是教学型指导的强度，不是分析型工具的能力**。
+它在代码里的全部落点就是「SCAFFOLD 段只拼给 navigator」。
+这条语义一旦被后人「顺手改回去」，论文对 Hsu(2026) SFM 的整段回应即失效，
+而 CI 不会有任何反应 —— 所以必须有测试直接断言拼装结果。
+"""
+import pytest
+
+from app.ai import (BASE_RULE, PROMPT_VERSION, ROLE_PROMPT, SCAFFOLD,
+                    SOCRATIC_OVERRIDE, _is_navigator, _system)
+
+
+@pytest.mark.parametrize("level", [0, 1, 2, 3])
+def test_driver_never_gets_scaffold_segment(level):
+    """driver（小狐·驾驶员）在**任何档位**下都不含档位段：工具能力不随渐退削弱。"""
+    s = _system("turtle", level, None, socratic=False)
+    assert ROLE_PROMPT["turtle"] in s
+    for seg in SCAFFOLD.values():
+        assert seg not in s, f"driver 在档位 {level} 拿到了档位段：{seg}"
+
+
+@pytest.mark.parametrize("level", [0, 1, 2, 3])
+def test_navigator_gets_exactly_its_own_scaffold_segment(level):
+    """navigator（小枭·领航员）按档位拿到且仅拿到**本档**的段：渐退在 navigator 侧真实生效。"""
+    s = _system("reviewer", level, None, socratic=False)
+    assert SCAFFOLD[level] in s
+    for other, seg in SCAFFOLD.items():
+        if other != level:
+            assert seg not in s
+
+
+@pytest.mark.parametrize("level", [0, 3])
+def test_socratic_forces_navigator_and_keeps_fading(level):
+    """强制苏格拉底把 driver 顶成 navigator —— 档位段随之回归，渐退不被角色切换绕开。
+
+    这条同时是方案A 的**旁路闸门**测试：学生把 role 改成 turtle 想绕开渐退时，
+    只要教师锁了苏格拉底，档位段仍然在场且写码授权被顶掉。
+    """
+    s = _system("turtle", level, None, socratic=True)
+    assert SCAFFOLD[level] in s
+    assert SOCRATIC_OVERRIDE in s
+    assert "按学生的指令写关键片段" not in s          # 写码授权仍被顶掉（既有语义不变）
+
+
+@pytest.mark.parametrize("role", ["turtle", "reviewer"])
+@pytest.mark.parametrize("level", [0, 1, 2, 3])
+def test_red_line_survives_every_role_and_level(role, level):
+    """最高红线（禁完整可运行答案代码）在所有角色 × 所有档位下原样在场 ——
+    方案A **没有**放宽任何红线，这是它能被接受的前提。"""
+    s = _system(role, level, None, socratic=False)
+    assert BASE_RULE in s
+    assert "绝对禁止直接输出完整、可复制运行的题目答案代码" in s
+
+
+def test_is_navigator_is_the_single_source_of_truth():
+    """谓词单一真源：三处判断必须同源，否则会出现「档位按 driver 算、四分类按 navigator 记」。"""
+    assert _is_navigator("reviewer", False) is True
+    assert _is_navigator("turtle", True) is True
+    assert _is_navigator("turtle", False) is False
+    assert _is_navigator("unknown", False) is False    # 未知角色回落 driver，不得意外拿到档位段
+
+
+def test_prompt_version_bumped_with_the_semantics():
+    """语义改了就必须升位：v1 的 ai_reply_log 四分类与 v2 的不可合并成一条曲线。"""
+    assert PROMPT_VERSION == "ai-prompt/v2", (
+        "SCAFFOLD 拼装语义已改为方案A，PROMPT_VERSION 必须同步升到 ai-prompt/v2；"
+        "不升位则跨版本 manipulation check 失效（ai.py 顶部的纪律注释）")
