+    scaffold_authoritative = L.get_state(uid)["scaffold_level"]
+    may_override = user.get("role") in ("teacher", "researcher")
+    if req.scaffold is not None and not may_override:
+        store.add_risk_event(
+            uid, "scaffold_override", 1,
+            f"忽略越权档位覆盖：请求 {req.scaffold} → 仍用权威档位 {scaffold_authoritative}")
+    scaffold = req.scaffold if (req.scaffold is not None and may_override) else scaffold_authoritative
     room = (req.roomId or "").strip()[:64]
     is_navigator = socratic or req.role == "reviewer"
     anchors = L.active_anchors(room) if (room and is_navigator) else []
