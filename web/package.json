{
  "name": "jiedui-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/lint-copy.mjs && node scripts/lint-style.mjs && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:style": "node scripts/lint-style.mjs",
    "check": "npm run typecheck && npm run lint:copy && npm run build",
    "build:only": "vite build",
    "fetch:pyodide": "node scripts/fetch-pyodide.mjs"
  },
  "dependencies": {
    "blockly": "^11.2.2",
    "echarts": "^5.6.0",
    "gsap": "^3.15.0",
    "monaco-editor": "^0.48.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13"
  }
}
