# 只供阅读/复制到 server/.env 后自行设置；不要把真实值提交到 Git。
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_IMG_URL=

# 默认 legacy 仅保留原本地兼容模式；不会因填写密钥自动进入可信会话。
# 如需验证可信链路，先阅读 docs/acceptance-history/README.md 与服务端合同，
# 使用合成测试数据、明确的任务/会话上下文，并完成当前模型预检后再选择：
# PAIR_AI_MODE=trusted_required
# 此注释不是当前真实 AI 已验收通过的声明，也不改变现有运行配置。

# 每次部署独立生成强随机值；为空不代表可安全部署。
JIEDUI_JWT_SECRET=
JIEDUI_TEACHER_PASSWORD=
JIEDUI_EXPORT_SALT=

CORS_ORIGINS=http://127.0.0.1:12210
# 拒绝后端裸执行；这不是已实现安全容器的证明。
SANDBOX_STRICT=1
# 可选：新建数据库的绝对路径，不填时采用原代码的本地路径。
# JIEDUI_DB_PATH=
